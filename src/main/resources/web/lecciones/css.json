        "outputs": {
          "en línea": "<p style=\"color: red;\">…</p>  → solo ese elemento",
          "interna": "<style> p { color: red; } </style>  → solo esta página",
          "externa": "<link rel=\"stylesheet\" href=\"estilos.css\">  → todas tus páginas"
        }
      },
      "remember": [
        [
          "Externa: la recomendada."
        ],
        [
          {
            "c": "<link>"
          },
          " va en el ",
