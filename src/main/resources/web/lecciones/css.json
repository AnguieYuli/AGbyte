  "lessons": {
    "¿Qué es CSS?": {
      "paras": [
        [
          "HTML arma la estructura de una página y CSS le da estilo: colores, tamaños, espacios y posiciones."
        ],
        [
          "Una regla CSS tiene un selector, que dice a qué elementos se aplica, y entre llaves una o más propiedades con su valor: ",
          {
            "c": "h1 { color: green; }"
          },
          "."
        ]
      ],
      "example": {
        "file": "estilos.css",
        "lines": [
          "h1 {",
          "  color: green;",
          "  font-size: 32px;",
          "}",
          "p {",
          "  color: gray;",
          "}"
        ],
        "output": [
          "[Título] verde y de 32 px",
          "[Párrafo] gris"
        ]
      },
      "tryit": {
        "label": "Pruébalo: elige un color para el título",
        "file": "prueba.css",
        "choices": [
          "green",
          "purple",
          "orange"
        ],
        "lines": [
          "h1 { color: {v}; }"
        ],
        "outputs": {
          "green": "[Título] ahora es verde",
          "purple": "[Título] ahora es morado",
          "orange": "[Título] ahora es naranja"
        }
      },
      "remember": [
        [
          "El selector va primero: ",
          {
            "c": "h1"
          },
          ", ",
          {
            "c": "p"
          },
          ", ",
          {
            "c": ".clase"
          },
          "."
        ],
        [
          "Las propiedades van entre llaves ",
          {
            "c": "{ }"
          },
          "."
        ],
        [
          "Cada propiedad termina con ",
          {
            "c": ";"
          },
          "."
        ]
      ],
      "tip": "Si un estilo no se aplica, revisa los dos puntos y el punto y coma: es el error más común en CSS.",
      "quiz": [
        {
          "prompt": "¿Para qué sirve CSS?",
          "code": [
            "/* Elige la respuesta */"
          ],
          "options": [
            "Para dar estilo a una página",
            "Para guardar datos",
            "Para hacer cálculos",
            "Para crear bases de datos"
          ],
          "answer": 0,
          "explain": "CSS controla cómo se ve una página: colores, tamaños y posiciones."
        },
        {
          "prompt": "¿Cuál de estas reglas está bien escrita?",
          "code": [
            "/* Solo una es correcta */"
          ],
          "options": [
            "p { color: red; }",
            "p ( color = red )",
            "{ p color: red }",
            "p: color red;"
          ],
          "answer": 0,
          "explain": "Selector, llaves, propiedad, dos puntos, valor y punto y coma."
        },
        {
          "prompt": "En esta regla, ¿cuál es el selector?",
          "code": [
            "h1 { color: blue; }"
          ],
          "options": [
            "h1",
            "color",
            "blue",
            "{ }"
          ],
          "answer": 0,
          "explain": "El selector indica a qué elementos se aplica la regla: aquí, a todos los h1."
        }
      ]
    },
    "Selectores": {
      "paras": [
        [
          "Un ",
          {
            "b": "selector"
          },
          " indica a qué elementos se aplica el estilo. Por etiqueta: ",
          {
            "c": "p { }"
          },
          ". Por clase: ",
          {
            "c": ".nota { }"
          },
          " (con punto). Por id: ",
          {
            "c": "#titulo { }"
          },
          " (con numeral)."
        ],
        [
          "Las clases se pueden repetir en muchos elementos; un id debe ser único en la página."
        ]
      ],
      "example": {
        "file": "estilos.css",
        "lines": [
          "p {",
          "  color: gray;",
          "}",
          ".nota {",
          "  color: crimson;",
          "}",
          "#titulo {",
          "  font-size: 40px;",
          "}"
        ],
        "output": [
          "[Todos los <p>] gris",
          "[class=\"nota\"] rojo carmesí",
          "[id=\"titulo\"] 40 px"
        ]
      },
      "tryit": {
        "label": "Pruébalo: elige el selector",
        "file": "estilos.css",
        "choices": [
          "p",
          ".nota",
          "#titulo"
        ],
        "lines": [
          "{v} {",
          "  color: crimson;",
          "}"
        ],
        "outputs": {
          "p": "Todos los párrafos se ponen carmesí",
          ".nota": "Solo los elementos con class=\"nota\"",
          "#titulo": "Solo el elemento con id=\"titulo\""
        }
      },
      "remember": [
        [
          "Etiqueta: ",
          {
            "c": "p"
          },
          "; clase: ",
          {
            "c": ".nombre"
          },
          "; id: ",
          {
            "c": "#nombre"
          },
          "."
        ],
        [
          "Una clase se reutiliza; un id es único."
        ],
        [
          "En el HTML: ",
          {
            "c": "class=\"nota\""
          },
          " y ",
          {
            "c": "id=\"titulo\""
          },
          "."
        ]
      ],
      "tip": "Prefiere clases para dar estilos: son más fáciles de reutilizar que los id.",
      "quiz": [
        {
          "prompt": "¿Qué selector elige elementos con class=\"boton\"?",
          "code": [
