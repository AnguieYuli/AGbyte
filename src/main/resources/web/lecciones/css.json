            "boton",
            "*boton"
          ],
          "answer": 0,
          "explain": "Las clases se seleccionan con punto."
        },
        {
          "prompt": "¿Qué selector elige el elemento con id=\"menu\"?",
          "code": [
            "___ { display: flex; }"
          ],
          "options": [
            "#menu",
            ".menu",
            "menu",
            "@menu"
          ],
          "answer": 0,
          "explain": "Los id se seleccionan con numeral (#)."
        },
        {
          "prompt": "¿Qué afecta el selector h2?",
          "code": [
            "h2 { color: navy; }"
          ],
          "options": [
            "Todos los <h2>",
            "Solo el primer <h2>",
            "Las clases h2",
            "Nada"
          ],
          "answer": 0,
          "explain": "Un selector de etiqueta afecta a todas esas etiquetas."
        }
      ]
    },
    "Propiedades y valores": {
      "paras": [
        [
          "Dentro de las llaves escribes ",
          {
            "b": "propiedad: valor;"
          },
          ". La propiedad es lo que cambias (color, tamaño, fondo) y el valor es cómo lo quieres."
        ],
        [
          "Cada declaración termina con ",
          {
            "c": ";"
          },
          ". Si olvidas uno, el navegador puede ignorar esa línea y la siguiente."
        ]
