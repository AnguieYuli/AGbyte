      "example": {
        "file": "main.cpp",
        "lines": [
          "#include <iostream>",
          "",
          "int main() {",
          "  std::cout << 7 / 2 << \" \" << 7.0 / 2 << \" \" << 7 % 2 << std::endl;",
          "  int puntos = 10;",
          "  puntos++;",
          "  puntos += 4;",
          "  std::cout << puntos << std::endl;",
          "  std::cout << (puntos > 12 && puntos < 20) << std::endl;",
          "  return 0;",
