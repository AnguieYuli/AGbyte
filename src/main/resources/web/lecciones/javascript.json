            "x vale ${x * 2}",
            "x vale 5",
            "Un error"
          ],
          "answer": 0,
          "explain": "Dentro de ${ } se calcula la expresión: 10."
        },
        {
          "prompt": "¿Qué comillas usan las plantillas de texto?",
          "code": [
            "// Elige una"
          ],
          "options": [
            "Invertidas `",
            "Dobles \"",
            "Simples '",
            "Ninguna"
