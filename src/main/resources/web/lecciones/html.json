  "lessons": {
    "¿Qué es HTML?": {
      "paras": [
        [
          "HTML es el lenguaje que describe el contenido de una página web: títulos, párrafos, imágenes y enlaces."
        ],
        [
          "Cada parte va dentro de etiquetas. ",
          {
            "c": "<h1>"
          },
          " abre un título y ",
          {
            "c": "</h1>"
          },
          " lo cierra. ",
          {
            "c": "<p>"
          },
          " crea un párrafo."
        ]
      ],
      "example": {
        "file": "index.html",
        "lines": [
          "<h1>¡Hola, mundo!</h1>",
          "<p>Estoy aprendiendo HTML</p>"
        ],
        "output": [
          "[Título] ¡Hola, mundo!",
          "[Párrafo] Estoy aprendiendo HTML"
        ]
      },
      "tryit": {
        "label": "Pruébalo: elige un nombre y mira la página",
        "file": "prueba.html",
        "choices": [
          "Ana",
          "Luis",
          "Sofía"
        ],
        "lines": [
          "<h1>Hola, {v}</h1>"
        ],
        "output": "[Título] Hola, {v}"
      },
      "remember": [
