    "html, head y body": {
      "paras": [
        [
          "Todo documento tiene tres partes: ",
          {
            "c": "<html>"
          },
          " envuelve todo; ",
          {
            "c": "<head>"
          },
          " guarda información para el navegador (título, idioma, estilos) y ",
          {
            "c": "<body>"
          },
          " guarda lo que se ve."
        ],
        [
          "En ",
          {
            "c": "<head>"
          },
          " suele ir ",
          {
            "c": "<meta charset=\"utf-8\">"
          },
          " para que las tildes y la ñ se vean bien."
        ]
      ],
      "diagram": {
        "parts": [
          {
            "t": "<head>",
            "label": "lo que no se ve",
            "kind": "name"
          },
          {
            "t": "+",
            "label": "dentro de <html>",
            "kind": "op"
          },
          {
            "t": "<body>",
            "label": "lo que se ve",
            "kind": "value"
          }
        ],
        "caption": "Cabeza para el navegador, cuerpo para las personas."
      },
      "example": {
        "file": "index.html",
        "lines": [
          "<!DOCTYPE html>",
          "<html lang=\"es\">",
          "  <head>",
          "    <meta charset=\"utf-8\">",
          "    <title>Mi sitio</title>",
          "  </head>",
          "  <body>",
          "    <h1>Bienvenidos</h1>",
          "    <p>Contenido de la página.</p>",
          "  </body>",
          "</html>"
        ],
        "output": [
          "[Pestaña] Mi sitio",
          "[Título] Bienvenidos",
          "[Párrafo] Contenido de la página."
        ]
      },
