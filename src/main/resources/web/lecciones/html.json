    "Tu primera página": {
      "paras": [
        [
          "Una página web es un archivo de texto con extensión ",
          {
            "c": ".html"
          },
          ". Empieza con ",
          {
            "c": "<!DOCTYPE html>"
          },
          ", que le dice al navegador que es HTML moderno."
        ],
        [
          "Dentro pones etiquetas como ",
          {
            "c": "<h1>"
          },
          " para el título y ",
          {
            "c": "<p>"
          },
          " para los párrafos. Guarda el archivo y ábrelo con doble clic: tu navegador lo mostrará."
        ]
      ],
      "example": {
        "file": "index.html",
        "lines": [
          "<!DOCTYPE html>",
          "<html>",
          "  <body>",
          "    <h1>Mi primera página</h1>",
          "    <p>¡Hola! Me llamo Alex.</p>",
          "    <p>Estoy aprendiendo HTML con AGbyte.</p>",
          "  </body>",
          "</html>"
        ],
        "output": [
          "[Título] Mi primera página",
          "[Párrafo] ¡Hola! Me llamo Alex.",
          "[Párrafo] Estoy aprendiendo HTML con AGbyte."
        ]
